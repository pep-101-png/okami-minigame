  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::Sunward.GameFlow
  valley: {fileID: 369893209}
  Player: {fileID: 1873811289}
  Combat: {fileID: 1873811284}
  Fx: {fileID: 369893208}
  Audio: {fileID: 369893207}
  Home: {fileID: 369893206}
  Shelf: {fileID: 369893205}
  spirits:
  - {fileID: 11400000, guid: 7506b34df23248b4a90335fbdc252d31, type: 2}
  - {fileID: 11400000, guid: 925130f6398ff5c459d242b28cf70e2a, type: 2}
  - {fileID: 11400000, guid: b63e46a9b9384574f97c5c577d78d4ee, type: 2}
  - {fileID: 11400000, guid: 88ed808bf7b1326459a4288a9d2613bf, type: 2}
  - {fileID: 11400000, guid: 22460a56479f94c4f9e3ddf65fd1e12e, type: 2}
  - {fileID: 11400000, guid: 0d4ef963997eb9547b15effde31786e6, type: 2}
  barrierMaterial: {fileID: 2100000, guid: 345140ebdfec4c54b84a8553cefbd132, type: 2}
  projectileMaterial: {fileID: 2100000, guid: 0c2768d97e85eea488db7565445299f0, type: 2}
  Health: 0
  Stamina: 0
  Energy: 0
  npcObjects:
  - {fileID: 2027807468}
  - {fileID: 1439298637}
  - {fileID: 812487609}
  - {fileID: 1697745362}
  - {fileID: 181726636}
  - {fileID: 2047080522}
  - {fileID: 1836519361}
  npcData:
  - asset: NPC-0
    name: "Hana \xB7 gardener"
    position:
    - -2
    - 0.27645388
    - -10
    lines:
    - Welcome to Windflower Village, little guardian.
    - The shadow spirits gather in the grove to the east. Follow the sign.
  - asset: NPC-1
    name: "Taro \xB7 merchant"
    position:
    - 3
    - 0
    - 2
    lines:
    - My stall is open, but the grove has frightened away the travelers.
    - Try a quick thrust, a sweeping second strike, then a lunging finish.
  - asset: NPC-2
    name: Elder Sora
    position:
    - -3
    - -0.14162081
    - 17
    lines:
    - Our shrine watches over this valley.
    - Restore the five spirits in the eastern grove, then return to wander in peace.
  - asset: NPC-3
    name: "Yui \xB7 traveler"
    position:
    - 1.9538405
    - 0.042334728
    - -18.838442
    lines:
    - Such a fine white wolf!
    - Hold Shift to run. K dodges. The village is safe; the grove is not.
  - asset: NPC-4
    name: "Akari \xB7 shrine musician"
    position:
    - -31
    - -0.05801251
    - -8
    lines:
    - The westbank bridges lead home. Rest there after each trial.
    - Your spirit keeps every earned coin, even after defeat.
  - asset: NPC-5
    name: "Mio \xB7 lantern keeper"
    position:
    - -38
    - 0
    - 10
    lines:
    - The Hollow Bell awakens beyond three waves.
    - Jump its ground shock, dodge its charge, and watch for ink bolts.
  - asset: NPC-6
    name: "Ren \xB7 pilgrim"
    position:
    - -31
    - -0.12158924
    - -22
    lines:
    - "A guardian\u2019s strength is remembered in ink."
    - Your shoulder and ankle fur will blossom with permanent power.
